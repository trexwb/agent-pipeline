{
  "project": {
    "name": "{projectName}",
    "dir": "{projectDir}"
  },
  "stages": [
    {
      "id": "01-issue-analysis",
      "name": "Issue 分析",
      "agent": "code-reviewer",
      "promptFile": "prompts/issue-01-analysis.md",
      "input": ["artifacts/00-requirement.md"],
      "output": "artifacts/issue-analysis.md"
    },
    {
      "id": "02-fix-plan",
      "name": "修复方案设计",
      "agent": "architect",
      "promptFile": "prompts/issue-02-fix-plan.md",
      "input": ["artifacts/issue-analysis.md"],
      "output": "artifacts/issue-fix-plan.md",
      "confirm": true
    },
    {
      "id": "03-fix-dev",
      "name": "开发修复",
      "agent": "developer",
      "promptFile": "prompts/issue-03-fix-dev.md",
      "input": ["artifacts/issue-analysis.md", "artifacts/issue-fix-plan.md"],
      "output": "artifacts/issue-fix-done.md"
    },
    {
      "id": "04-fix-test",
      "name": "修复验证",
      "agent": "tester",
      "promptFile": "prompts/issue-04-fix-test.md",
      "input": ["artifacts/issue-analysis.md", "artifacts/issue-fix-plan.md", "artifacts/issue-fix-done.md"],
      "output": "artifacts/issue-test-report.md"
    },
    {
      "id": "05-pr-summary",
      "name": "PR 描述",
      "agent": "devops",
      "promptFile": "prompts/issue-05-pr-summary.md",
      "input": ["artifacts/issue-analysis.md", "artifacts/issue-fix-plan.md", "artifacts/issue-fix-done.md", "artifacts/issue-test-report.md"],
      "output": "artifacts/issue-pr.md"
    }
  ],
  "retry": {
    "checkStage": "04-fix-test",
    "failPattern": "VERDICT:\\s*FAIL",
    "resumeStage": "03-fix-dev",
    "maxRounds": 2
  },
  "_comment": "阶段字段：id/name/agent（对应 agents.json 键）、promptFile（相对 skill 根）、input（前序产物路径列表，缺失仅告警）、output（产物落盘路径，null=不落盘）、confirm=true 表示产出后需人工确认（--interactive/--remote 生效）、model/fallbackModels 可在阶段级覆盖。顶层 retry：验证阶段（checkStage）产物命中 failPattern 且轮数未用尽时，编排器自动携带验证报告回 resumeStage 重修，最多 maxRounds 轮（--fix-rounds 可覆盖，0=关闭）。首个阶段读 artifacts/00-requirement.md：手动跑时由 --requirement 写入，watch-issues 触发时由监听器写入。"
}
