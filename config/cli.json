{
  "adapter": "auto",
  "host": "auto",
  "autoDetect": [
    "codebuddy",
    "cbc",
    "workbuddy",
    "zcode",
    "qoder",
    "marvis",
    "claude",
    "codex"
  ],
  "timeoutMs": 3600000,
  "permissions": "skip",
  "outputFormat": "text",
  "hostCommands": {
    "codebuddy": {
      "commands": ["codebuddy", "cbc"],
      "env": "CODE_BUDDY_CMD",
      "adapter": "codebuddy",
      "configDir": ".codebuddy",
      "_comment": "CodeBuddy Code CLI，原生支持 --agent/--agents 与 --fallback-model"
    },
    "cbc": {
      "commands": ["cbc"],
      "env": "CODE_BUDDY_CMD",
      "adapter": "codebuddy",
      "configDir": ".codebuddy"
    },
    "workbuddy": {
      "commands": ["workbuddy"],
      "env": "WORK_BUDDY_CMD",
      "adapter": "codebuddy",
      "configDir": ".workbuddy",
      "_comment": "WorkBuddy 内置 CLI 与 CodeBuddy 同源，复用 codebuddy 方言"
    },
    "zcode": {
      "commands": ["zcode"],
      "env": "ZCODE_CLI_CMD",
      "adapter": "plain",
      "configDir": ".zcode"
    },
    "qoder": {
      "commands": ["qoder", "qoder-cli"],
      "env": "QODER_CLI_CMD",
      "adapter": "plain",
      "configDir": ".qoder"
    },
    "marvis": {
      "commands": ["marvis"],
      "env": "MARVIS_CLI_CMD",
      "adapter": "plain",
      "configDir": ".marvis",
      "_comment": "Marvis 桌面助手通常无 headless CLI；如已配置可用命令，改 plain.command 或设置 MARVIS_CLI_CMD"
    }
  },
  "plain": {
    "command": "",
    "promptMode": "arg",
    "extraArgs": [],
    "_comment": "显式 adapter=plain 且未命中宿主命令时必填 command，如 'aider --message'。promptMode: arg=提示词作为最后一个参数；stdin=提示词写入标准输入。extraArgs 插在提示词之前。"
  }
}
